---
import '../styles/global.css';
import '@fontsource-variable/plus-jakarta-sans/index.css';
import Icon from '../components/Icon.astro';
import { ui, href, tr, type Locale } from '../i18n/ui';
interface Props { locale?: Locale; title: string; description?: string; section?: string; path?: string; }
const { locale = 'en', title, description = 'Untung Tanujaya — backend engineer working with Go and Python, and M.S. Software Engineering student at Harbin Institute of Technology.', section = '', path = '' } = Astro.props;
const t = ui[locale];
const canonical = new URL(href(locale, path), Astro.site);
const other = locale === 'en' ? 'zh' : 'en';
const nav = ['work', 'research', 'writing', 'cv'] as const;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Untung Tanujaya</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), Astro.site)} />
    <link rel="alternate" hreflang="zh-Hans" href={new URL(href('zh', path), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('en', path), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={t.feed} href={`/${locale}/feed.xml`} />
    <meta property="og:title" content={`${title} · Untung Tanujaya`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={new URL('/untung-tanujaya.webp', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Untung Tanujaya', url: Astro.site, jobTitle: 'Backend Engineer', sameAs: ['https://github.com/untungtanujaya', 'https://linkedin.com/in/tanujaya'] })} />
    <script is:inline>
      (() => { let theme = 'system'; try { theme = localStorage.getItem('ut-theme') || 'system'; } catch {} const dark = theme === 'dark' || (theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.dataset.theme = dark ? 'dark' : 'light'; document.documentElement.dataset.preference = theme; })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={href(locale)} aria-label={`Untung Tanujaya — ${t.home}`}><span class="monogram">ut<span>.</span></span><span class="brand-name">Untung Tanujaya</span></a>
        <nav class="desktop-nav" aria-label={tr(locale, 'Main navigation', '主导航')}>
          {nav.map(key => <a href={href(locale, key)} aria-current={section === key ? 'page' : undefined}>{t[key]}</a>)}
        </nav>
        <div class="header-controls">
          <a class="icon-button" href={href(locale, 'search')} aria-label={t.search} title={t.search}><Icon name="search" size={18} /></a>
          <a class="locale-switch" href={href(other, path)} hreflang={other === 'zh' ? 'zh-Hans' : 'en'} lang={other === 'zh' ? 'zh-Hans' : 'en'} data-locale-switch aria-label={other === 'zh' ? '切换到中文' : 'Switch to English'}>{other === 'zh' ? '中文' : 'EN'}</a>
          <label class="theme-control"><span class="sr-only">{t.theme}</span><Icon name="sun" size={17}/><select id="theme" aria-label={t.theme}><option value="system">{t.system}</option><option value="light">{t.light}</option><option value="dark">{t.dark}</option></select></label>
        </div>
        <details class="mobile-menu"><summary>{t.menu}<span aria-hidden="true">+</span></summary><nav aria-label={tr(locale, 'Mobile navigation', '移动导航')}><a href={href(locale)}>{t.home}</a>{nav.map(key => <a href={href(locale, key)} aria-current={section === key ? 'page' : undefined}>{t[key]}</a>)}<a href={href(locale, 'tools')}>{t.tools}</a></nav></details>
      </div>
    </header>
    <main id="content" class="page-shell" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><div><p class="eyebrow">{tr(locale, 'Keep the conversation going', '保持交流')}</p><h2>{tr(locale, 'Let’s build something thoughtful.', '一起把想法做扎实。')}</h2><a class="text-link" href="mailto:utanujaya@gmail.com">utanujaya@gmail.com <Icon name="external" size={18}/></a></div><div class="footer-links"><a href="https://github.com/untungtanujaya">GitHub <Icon name="external" size={14}/></a><a href="https://linkedin.com/in/tanujaya">LinkedIn <Icon name="external" size={14}/></a><a href={href(locale, 'tools')}>{t.tools}</a><a href={`/${locale}/feed.xml`}>{t.feed}</a></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Untung Tanujaya</span><span>{tr(locale, 'Backend engineering · Research · Notes', '后端工程 · 研究 · 技术笔记')}</span><a href="#content">{tr(locale, 'Back to top ↑', '回到顶部 ↑')}</a></div>
    </footer>
    <script>
      const select = document.querySelector<HTMLSelectElement>('#theme');
      const media = matchMedia('(prefers-color-scheme: dark)');
      let preference = document.documentElement.dataset.preference || 'system';
      const apply = () => { const theme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference; document.documentElement.dataset.theme = theme; document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#101820' : '#f8fafc'); };
      if (select) { select.value = preference; select.addEventListener('change', () => { preference = select.value; try { localStorage.setItem('ut-theme', preference); } catch {} apply(); }); }
      media.addEventListener('change', apply); apply();
      document.querySelector<HTMLAnchorElement>('[data-locale-switch]')?.addEventListener('click', e => { const a = e.currentTarget as HTMLAnchorElement; a.href = a.pathname + location.search + location.hash; });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelector<HTMLDetailsElement>('.mobile-menu')?.removeAttribute('open'); });
    </script>
  </body>
</html>
