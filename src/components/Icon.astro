const { name = 'arrow', size = 20 } = Astro.props;
const paths = { arrow: 'M5 12h14m-6-6 6 6-6 6', external: 'M7 17 17 7M7 7h10v10', search: 'M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0', sun: 'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0', mail: 'M3 5h18v14H3zM3 5l9 8 9-8', code: 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-14-2 18' };
---
