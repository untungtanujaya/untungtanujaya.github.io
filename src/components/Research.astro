---
import { getCollection } from 'astro:content';
import PageIntro from './PageIntro.astro';
import Icon from './Icon.astro';
import { ui,tr,href,date,type Locale } from '../i18n/ui';
import { interests,updates } from '../data/research';
const { locale, publicationsOnly=false }=Astro.props as {locale:Locale;publicationsOnly?:boolean};const t=ui[locale];
const publications=(await getCollection('publications',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<PageIntro eyebrow={tr(locale,'Research / Harbin Institute of Technology','研究 / 哈尔滨工业大学')} title={publicationsOnly?t.publications:tr(locale,'Learning. Building. Investigating.','学习、构建与探索。')} description={publicationsOnly?tr(locale,'Papers, preprints, and the work behind them.','论文、预印本及其背后的研究工作。'):tr(locale,'I’m pursuing an M.S. in Software Engineering, combining advanced coursework with applied research. My interests connect the systems I’ve built with the questions I want to explore next.','我正在攻读软件工程理学硕士，将高阶课程与应用研究相结合。我的研究兴趣连接已有工程实践与希望进一步探索的问题。')}/>
{!publicationsOnly && <><div class="content-grid"><aside class="side-note"><p class="eyebrow">{tr(locale,'Current programme','当前学业')}</p><p>{tr(locale,'M.S. Software Engineering','软件工程理学硕士')}<br/>{tr(locale,'Harbin Institute of Technology','哈尔滨工业大学')}</p><p>{tr(locale,'September 2026 — Present','2026年9月至今')}<br/>{tr(locale,'Harbin, China','中国哈尔滨')}</p><a class="text-link" href={href(locale,'cv')}>{t.cv}<Icon size={16}/></a></aside><div><div class="content-block"><h2>{tr(locale,'Areas of interest','关注方向')}</h2><div class="research-lines" style="border-left:0;padding-left:0">{interests.map((item,i)=><div><p class="eyebrow">0{i+1}</p><strong>{item[locale]}</strong><p>{item.description[locale]}</p></div>)}</div></div><div class="content-block" id="updates"><h2>{tr(locale,'Research updates','研究动态')}</h2>{updates.map(item=><article><p class="eyebrow"><time datetime={item.date}>{tr(locale,'September 2026','2026年9月')}</time></p><h3 style="font-size:20px;margin-bottom:14px">{item.title[locale]}</h3><p class="body-copy">{item.body[locale]}</p></article>)}</div></div></div><div class="section-heading"><div><p class="eyebrow">{tr(locale,'Academic work','学术成果')}</p><h2>{t.publications}</h2></div><a class="text-link" href={href(locale,'research/publications')}>{tr(locale,'View publications','查看学术发表')}<Icon size={16}/></a></div></>}
{publications.length ? <div>{publications.map(pub=><article class="publication-row"><p class="eyebrow">{date(pub.data.date,locale)} · {pub.data.status==='published'?tr(locale,'Published','已发表'):tr(locale,'Preprint','预印本')}</p><h2><a href={href(locale,`research/publications/${pub.id}`)}>{pub.data.title[locale]}</a></h2><p>{pub.data.authors.join(', ')} · {pub.data.venue}</p></article>)}</div> : <div class="empty-state"><p class="eyebrow">{tr(locale,'Research in progress','研究进行中')}</p><h2>{tr(locale,'No publications to share yet.','目前尚无公开发表成果。')}</h2><p>{tr(locale,'I’m at the beginning of my graduate research. Papers and preprints will appear here when they are ready to share. In the meantime, explore my engineering notes.','我的研究生科研之旅刚刚开始。论文与预印本准备好后会在这里发布。目前可以先阅读我的工程实践笔记。')}</p><a class="text-link" style="margin-top:18px" href={href(locale,'writing')}>{tr(locale,'Read engineering notes','阅读工程笔记')}<Icon size={16}/></a></div>}
