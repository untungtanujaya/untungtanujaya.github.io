---
import WorkList from './WorkList.astro';
import ArticleList from './ArticleList.astro';
import Icon from './Icon.astro';
import { href, tr, ui, type Locale } from '../i18n/ui';
import { interests } from '../data/research';
const { locale } = Astro.props as { locale: Locale }; const t = ui[locale];
---
<section class="hero" aria-labelledby="home-title"><div><p class="eyebrow">{tr(locale,'Backend engineer / M.S. student','后端工程师 / 硕士研究生')}</p><h1 id="home-title">{tr(locale,'Reliable systems.','构建可靠的系统。')}<span>{tr(locale,'Curious by design.','保持探索的好奇。')}</span></h1><p class="hero-lede">{tr(locale,'I’m Untung Tanujaya. I build','我是 Untung Tanujaya，专注于')} <strong>{tr(locale,'backends and data pipelines','后端系统与数据流水线')}</strong>{tr(locale,' in Go and Python, with a practical eye for production reliability. Now exploring the next chapter through graduate study in software engineering.','，使用 Go 与 Python，重视生产环境中的可靠性。目前正在攻读软件工程硕士，探索新的研究方向。')}</p><div class="actions"><a class="button primary" href={href(locale,'work')}>{tr(locale,'Explore my work','了解工程实践')}<Icon size={18}/></a><a class="text-link" href={href(locale,'cv')}>{tr(locale,'View CV','查看简历')}<Icon name="external" size={17}/></a></div></div><aside class="profile-note" aria-label={tr(locale,'About Untung','关于 Untung')}><img class="portrait" src="/untung-tanujaya.webp" alt="Untung Tanujaya" width="86" height="86" fetchpriority="high"/><h2>Untung Tanujaya</h2><p>Go · Python · {tr(locale,'Distributed systems','分布式系统')}</p><div class="profile-divider"></div><div class="study-note"><div class="status-line"><span class="status-dot"></span>{tr(locale,'Currently studying','目前就读')}</div><p style="margin-top:10px">{tr(locale,'M.S. Software Engineering','软件工程理学硕士')}<br/>{tr(locale,'Harbin Institute of Technology','哈尔滨工业大学')}</p></div><p class="location">{tr(locale,'Harbin, China · Since Sep 2026','中国 · 哈尔滨 · 2026年9月起')}</p></aside></section>
<div class="capability-strip"><span>{tr(locale,'PREVIOUSLY BUILDING AT','曾参与工程实践的团队')}</span><div class="companies"><span>fr8co</span><span>Tokopedia</span><span>Konimex</span><span>Blibli</span></div></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">02 / {tr(locale,'Engineering','工程实践')}</p><h2>{tr(locale,'Work in production.','来自生产环境的实践。')}</h2></div><a class="text-link" href={href(locale,'work')}>{t.allWork}<Icon size={16}/></a></div><p class="section-description">{tr(locale,'Concurrent services, document pipelines, and the infrastructure that keeps them running.','并发服务、文档处理流水线，以及支撑它们稳定运行的基础设施。')}</p><WorkList locale={locale} limit={3}/></section>
<section class="section"><div class="research-feature"><div><p class="eyebrow">03 / {t.research}</p><div class="status-line"><span class="status-dot"></span>{tr(locale,'A new chapter','新的阶段')}</div><h2>{tr(locale,'From building systems to asking better questions.','从构建系统，到提出更好的问题。')}</h2><p>{tr(locale,'Graduate study at HIT brings together advanced coursework and applied research in software engineering. This is where I’ll share that work as it develops.','在哈工大的研究生学习将高阶课程与软件工程应用研究相结合。我将在这里持续分享研究进展。')}</p><a class="text-link" style="margin-top:16px" href={href(locale,'research')}>{tr(locale,'Explore research','了解研究方向')}<Icon size={17}/></a></div><div class="research-lines">{interests.map(item=><div><strong>{item[locale]}</strong><p>{item.description[locale]}</p></div>)}</div></div></section>
<section class="section"><div class="section-heading"><div><p class="eyebrow">04 / {tr(locale,'Field notes','技术笔记')}</p><h2>{tr(locale,'Lessons from the backend.','后端实践中的思考。')}</h2></div><a class="text-link" href={href(locale,'writing')}>{t.allWriting}<Icon size={16}/></a></div><ArticleList locale={locale} limit={3}/></section>
