---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
const sortedArticles = articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Articles | Untung Tanujaya" activeTab="articles" description="Technical articles and writeups about systems, Go concurrency, performance optimization, and software development.">
  <div class="bento-grid">
    <header class="page-hero span-12">
      <div>
        <p class="eyebrow">Writing</p>
        <h1 class="page-title">Technical Articles</h1>
        <p class="page-copy">
          Practical writeups on concurrency, distributed rate limiting, idempotent reprocessing, and backend testing edge cases.
        </p>
      </div>
    </header>

    <div class="article-list span-12">
      {sortedArticles.map((art) => {
        const slug = art.data.slug || art.id;
        return (
          <a href={`/articles/${slug}/`} class="article-card" data-reveal>
            <div class="article-card-top">
              <p class="card-meta">{art.data.subtitle}</p>
              <h2 class="art-title">{art.data.title}</h2>
              <p class="art-desc">{art.data.summary}</p>
            </div>
            <div class="article-card-meta">
              <span>{art.data.read_time} min read</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
